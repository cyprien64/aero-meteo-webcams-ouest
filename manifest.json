{
  "manifest_version": 3,
  "name": "Aéro Météo — France",
  "short_name": "Aéro Météo",
  "version": "2.2.0",
  "description": "Carte des webcams, observations Météociel, METAR/TAF, NOTAM, SUP AIP, balises vent et radar de France métropolitaine avec préparation de vol et briefing PDF (VAC, NOTAM, SUP AIP, AZBA).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ouvrir la carte Aéro Météo",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://aviationweather.gov/*",
    "https://cam-aero.eu/*",
    "https://api.pioupiou.fr/*",
    "https://api.rainviewer.com/*",
    "https://*.github.io/*",
    "https://www.sia.aviation-civile.gouv.fr/*",
    "https://api.open-meteo.com/*",
    "https://data.geopf.fr/*",
    "https://api.met.no/*",
    "https://view.eumetsat.int/*"
  ]
}
